# Frontend only. Set these in .env.local for Vite; never put provider secrets here.
VITE_CONVEX_URL=https://<deployment>.convex.cloud
VITE_VANTA_CONVEX_URL=https://<vanta-deployment>.convex.cloud
VITE_VANTA_DEV_CONVEX_URL=https://<vanta-dev-deployment>.convex.cloud
VITE_VANTA_PROD_CONVEX_URL=https://<vanta-production-deployment>.convex.cloud
# Server-side only on Reva Convex. Never expose the API key to Vite/browser code.
VANTA_API_BASE_URL=https://<vanta-production-deployment>.convex.site
VANTA_API_KEY=<vanta-api-key-with-read-scope>
# Enable only for local Vite development when the Vanta Development fallback is configured.
VITE_REVA_ALLOW_DEV_SIGNUP=false

# On each Reva Convex deployment, trust the matching Vanta Convex Auth issuer.
VANTA_CONVEX_SITE_URL=https://<vanta-production-deployment>.convex.site
VANTA_DEV_CONVEX_SITE_URL=https://<vanta-dev-deployment>.convex.site

# Gemini: used by grounded benchmark research and preliminary document screening.
GEMINI_API_KEY=<google-ai-studio-key>
GEMINI_MODEL=gemini-3.8-flash

# Resend: used for screening notification emails (separate sender config from auth).
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Reva <alerts@your-verified-domain.example>
DIT_NOTIFICATION_EMAIL=digital-incubation@trium.ng
DIT_ALERT_THRESHOLD_SCORE=66

# Configure these server-side on Reva Convex. The Reva admin controls source activation.
REVA_ADMIN_EMAIL=<reva-admin-email>
